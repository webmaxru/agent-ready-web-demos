{
  "note": "What standards-watch.mjs checks. Each entry names the page, and how to read one version string from it. As of 2 November 2026.",
  "entries": [
    {
      "id": "mcp",
      "name": "Model Context Protocol, current revision",
      "url": "https://modelcontextprotocol.io/specification/versioning",
      "type": "text",
      "pattern": "current protocol version is (\\d{4}-\\d{2}-\\d{2})"
    },
    {
      "id": "webmcp",
      "name": "WebMCP, W3C Community Group draft report",
      "url": "https://webmachinelearning.github.io/webmcp/",
      "type": "html",
      "pattern": "Draft Community Group Report</a>,\\s*<time class=\"dt-updated\" datetime=\"(\\d{4}-\\d{2}-\\d{2})\""
    },
    {
      "id": "webbotauth",
      "name": "Web Bot Auth, IETF draft-ietf-webbotauth-httpsig-protocol",
      "url": "https://datatracker.ietf.org/doc/draft-ietf-webbotauth-httpsig-protocol/doc.json",
      "type": "json",
      "fields": [
        "rev",
        "time"
      ]
    },
    {
      "id": "aipref-vocab",
      "name": "AI preferences vocabulary, IETF draft-ietf-aipref-vocab",
      "url": "https://datatracker.ietf.org/doc/draft-ietf-aipref-vocab/doc.json",
      "type": "json",
      "fields": [
        "rev",
        "time"
      ]
    },
    {
      "id": "aipref-attach",
      "name": "AI preferences in robots.txt and HTTP, IETF draft-ietf-aipref-attach",
      "url": "https://datatracker.ietf.org/doc/draft-ietf-aipref-attach/doc.json",
      "type": "json",
      "fields": [
        "rev",
        "time"
      ]
    },
    {
      "id": "schema-org",
      "name": "schema.org, latest release",
      "url": "https://schema.org/docs/releases.html",
      "type": "text",
      "pattern": "(\\d{2}\\.\\d+)\\s+(\\d{4}-\\d{2}-\\d{2})"
    },
    {
      "id": "llms-txt",
      "name": "llms.txt proposal, last modified",
      "url": "https://llmstxt.org/",
      "type": "text",
      "pattern": "Modified (\\w+ \\d{1,2}, \\d{4})"
    },
    {
      "id": "lighthouse",
      "name": "Lighthouse (Agentic Browsing category), npm latest",
      "url": "https://registry.npmjs.org/lighthouse/latest",
      "type": "json",
      "fields": [
        "version"
      ]
    }
  ]
}
