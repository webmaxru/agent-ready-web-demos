{
  "name": "nordlys-cabins",
  "version": "1.0.0",
  "private": true,
  "description": "Nordlys Cabins: the running example of The Agent-Ready Web, made agent-ready one layer per chapter",
  "license": "MIT",
  "author": "Maxim Salnikov",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "start:legacy": "node server.js --variant=legacy",
    "start:baseline": "node server.js --variant=legacy --upto=0",
    "dev": "node --watch server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@scalar/openapi-parser": "0.29.19",
    "jsonld": "9.0.0"
  }
}
