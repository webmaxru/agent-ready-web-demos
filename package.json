{
  "name": "agent-ready-web-demos",
  "private": true,
  "description": "Runnable demos for the book Building Agent-Ready Websites by Maxim Salnikov",
  "license": "MIT",
  "author": "Maxim Salnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webmaxru/agent-ready-web-demos.git"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "nordlys-cabins",
    "chapters/*"
  ],
  "scripts": {
    "start": "npm start -w nordlys-cabins --",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present"
  }
}
